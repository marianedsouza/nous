# Copie para .env e ajuste os valores em producao
PORT=3000
# Use uma string longa e aleatoria em producao
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
NODE_ENV=development

# --- Supabase (Postgres) ---
# A chave publishable NÃO cria tabelas. Para rodar `npm run db:push:supabase`,
# use a connection string (Settings > Database > Connection string):
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
