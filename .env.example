# Copie para .env e ajuste os valores em producao
PORT=3000
# Use uma string longa e aleatoria em producao
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
NODE_ENV=development

# --- Supabase (Postgres) ---
# OBRIGATORIO: connection string do Postgres. O app usa isto para ler/gravar.
# Supabase > Project Settings > Database > Connection string (URI).
# Prefira a porta 6543 (pooler/Transaction) para ambiente serverless (Vercel).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Chaves publicas (opcionais; nao criam tabelas nem sao usadas pelo backend atual)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
