# Copie para .env e ajuste os valores em producao
PORT=3000
# Use uma string longa e aleatoria em producao
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
NODE_ENV=development

# --- SDK do Supabase (usado pelo backend) ---
# O backend acessa o banco e o storage via SDK usando a SECRET key (service role).
# Supabase > Project Settings > API. NUNCA commite a secret key.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Bucket de Storage para os arquivos de documento (default: docs)
SUPABASE_DOCS_BUCKET=docs

# Chaves publicas (frontend) — opcionais, nao usadas pelo backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
